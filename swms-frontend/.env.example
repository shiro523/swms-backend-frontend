# Copy to .env.local and fill in real values. Never commit the real .env.local file.

# Where Next.js proxies same-origin /api/* calls to (see next.config.ts).
# Optional in development — defaults to the backend's own dev-server default,
# http://localhost:8000 (see backend-swms's .env.example: PORT=8000).
# Required in production — point this at your deployed backend's URL.
BACKEND_URL=http://localhost:8000

# Used by proxy.ts (Next 16's middleware) to verify the auth JWT at the edge,
# purely as a UX guard that redirects signed-out/wrong-role users — the
# backend independently re-verifies the same cookie on every request, so
# this is not the real security boundary.
#
# MUST be set to the exact same value as backend-swms's JWT_SECRET. If they
# differ, every request will look "logged out" to this UX guard (redirect
# loop to /login) even though the backend session is still valid.
AUTH_JWT_SECRET=replace-with-the-same-value-as-backend-swms-JWT_SECRET
