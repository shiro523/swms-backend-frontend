# Copy to .env and fill in real values. Never commit the real .env file.

# Server
PORT=8000
# development only: NODE_ENV can be left unset (npm run dev never sets it).
# Set NODE_ENV=production explicitly in your production environment — several
# security-relevant defaults (CORS origin, cookie Secure flag) depend on it.
NODE_ENV=development

# Required in production. In development, an unset value safely falls back to
# http://localhost:3000. In production this is required — the app will
# refuse to start without it, rather than silently using localhost as the
# CORS origin.
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
# Optional explicit override. If unset, defaults to true when
# NODE_ENV=production and false otherwise. Only set this if you need to
# force a specific value regardless of NODE_ENV.
# COOKIE_SECURE=true

# Database (Neon or any PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# SMTP (used for the forgot-password email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Guard for backend-swms/prisma/wipe.ts and seed.ts — see guardDestructiveOp.ts.
# Never set this in a production environment.
# ALLOW_DESTRUCTIVE_DB_OPS=yes-wipe-dev-db

# Guard for backend-swms/prisma/seedDemo.ts — a separate, non-destructive
# safety gate (this script never deletes or truncates anything, it only adds
# demo records). Still requires explicit opt-in so demo data is never
# injected into a database just because the command exists.
# Never set this in a production environment.
# ALLOW_DEMO_SEED=yes-seed-demo-data
