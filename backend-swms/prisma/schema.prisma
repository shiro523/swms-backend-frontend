// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Purok {
  id             String         @id
  name           String
  leaderName     String         @map("leader_name")
  complianceRate Int            @default(0) @map("compliance_rate")
  households     Household[]
  users          User[]
  notifications  Notification[]
  // Null = active. Set = archived (recoverable for 30 days from this
  // timestamp; see purok.service.ts for the restore/permanent-delete rules).
  archivedAt     DateTime?      @map("archived_at")

  @@map("puroks")
}

model Household {
  id             String         @id
  code           String         @unique
  representative String
  address        String
  purokId        String         @map("purok_id")
  purok          Purok          @relation(fields: [purokId], references: [id], onDelete: Cascade)
  contactNumber  String         @map("contact_number")
  registeredAt   DateTime       @map("registered_at") @db.Date
  paymentStatus  String         @map("payment_status")
  complianceRate Int            @default(0) @map("compliance_rate")
  members        FamilyMember[]
  trashLogs      TrashLog[]
  violations     Violation[]
  payments       Payment[]
  users          User[]
  notifications  Notification[]

  @@index([purokId])
  @@map("households")
}

model FamilyMember {
  id          String    @id
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  relation    String
  age         Int

  @@index([householdId])
  @@map("family_members")
}

model TrashLog {
  id          String    @id
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  logDate     DateTime  @map("log_date") @db.Date
  logTime     String    @map("log_time")
  collector   String
  status      String
  disposedBy  String    @map("disposed_by")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([householdId])
  @@unique([householdId, logDate])
  @@map("trash_logs")
}

model Violation {
  id          String    @id
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type        String
  vDate       DateTime  @map("v_date") @db.Date
  isRepeat    Boolean   @default(false) @map("is_repeat")
  notes       String    @default("")

  @@index([householdId])
  @@map("violations")
}

model Payment {
  id          String    @id
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  period      String
  amount      Decimal   @db.Decimal(10, 2)
  status      String
  datePaid    DateTime? @map("date_paid") @db.Date
  orNumber    String?   @map("or_number")

  @@unique([householdId, period])
  @@index([householdId])
  @@map("payments")
}

model Notification {
  id                String             @id
  title             String
  message           String
  type              String
  nDate             DateTime           @map("n_date") @db.Date
  targetPurokId     String?            @map("target_purok_id")
  targetPurok       Purok?             @relation(fields: [targetPurokId], references: [id], onDelete: Cascade)
  targetHouseholdId String?            @map("target_household_id")
  targetHousehold   Household?         @relation(fields: [targetHouseholdId], references: [id], onDelete: Cascade)
  // Distinguishes, within a purok-wide notification, an Admin announcement
  // meant for that purok's residents too (false, the default — restores the
  // pre-Batch-E behavior for every existing row) from an automatic
  // violation leader-alert meant for the purok leader only (true), which
  // must never reach the unrelated resident whose household wasn't involved
  // (Batch E correction).
  leaderOnly        Boolean            @default(false) @map("leader_only")
  reads             NotificationRead[]

  @@index([targetPurokId])
  @@index([targetHouseholdId])
  @@map("notifications")
}

// Per-user read state — replaces the old shared Notification.isRead boolean
// (Batch E). A row's presence means that specific user has read that specific
// notification; its absence means unread, for that user only. The composite
// PK is both the uniqueness guarantee and the natural upsert key.
model NotificationRead {
  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId         Int          @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt         DateTime     @default(now()) @map("read_at")

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

model MonthlyCollectionStat {
  ord        Int    @id
  month      String
  compliant  Int
  violations Int
  missed     Int

  @@map("monthly_collection_stats")
}

model PaymentCollectionStat {
  ord       Int    @id
  month     String
  collected Int
  target    Int

  @@map("payment_collection_stats")
}

// Singleton system-wide configuration (Batch F) — always exactly one row,
// id fixed at 1. Neutral defaults (empty strings, zero fee) rather than
// fabricated production data; the admin fills these in themselves.
model SystemSettings {
  id                   Int      @id @default(1)
  barangayName         String   @default("") @map("barangay_name")
  municipality         String   @default("")
  contactNumber        String   @default("") @map("contact_number")
  monthlyCollectionFee Decimal  @default(0) @db.Decimal(10, 2) @map("monthly_collection_fee")
  collectionDays       String   @default("") @map("collection_days")
  collectionTime       String   @default("") @map("collection_time")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model User {
  id                  Int        @id @default(autoincrement())
  username            String     @unique
  passwordHash        String     @map("password_hash")
  role                String
  name                String
  email               String     @unique
  resetTokenHash      String?    @map("reset_token_hash")
  resetTokenExpiresAt DateTime?  @map("reset_token_expires_at")
  householdId         String?    @map("household_id")
  household           Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  purokId             String?    @map("purok_id")
  purok               Purok?     @relation(fields: [purokId], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now()) @map("created_at")
  // Bumped on security-sensitive events (currently: password reset) to
  // invalidate any previously issued JWTs — see token.ts/auth.middleware.ts.
  tokenVersion        Int        @default(0) @map("token_version")
  notificationReads   NotificationRead[]

  @@index([householdId])
  @@index([purokId])
  @@map("users")
}
