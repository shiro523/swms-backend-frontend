# Copy to .env.test and fill in your own ISOLATED test database connection
# string. Never commit the real .env.test file — it is gitignored.
#
# This must point at a database that is NOT the real Neon database used by
# .env — a separate Neon database or branch created specifically for
# automated tests. `npm test` applies the full Prisma migration history to
# whatever DATABASE_URL is set here, so it must never be the production
# connection string.
#
# NODE_ENV=test is set automatically by `npm test` itself — it does not need
# to be set in this file.

DATABASE_URL=postgresql://user:password@host/isolated-test-db?sslmode=require

# src/config/env.ts requires JWT_SECRET unconditionally at module load —
# even a test that never touches the HTTP layer needs this, since importing
# src/lib/prisma.ts transitively imports config. Use a random, test-only
# value here; it only ever signs/verifies tokens issued during test runs
# against the isolated test database, never a real session.
JWT_SECRET=replace-with-a-random-test-only-value

# Required marker — the test runner refuses to start unless this exact value
# is present in backend-swms/.env.test specifically. This is a second,
# independent signal (beyond NODE_ENV=test) that a real, deliberately
# isolated test environment is active, so the suite can never run just
# because *some* DATABASE_URL happens to be set.
TEST_DB_CONFIRM=true
